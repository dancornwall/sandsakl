function Slideshow(obj) {
	var duration = 5000;

	var images = $("img", obj);

	var timer = setInterval(function () {
		var found;
		images.each(function(index) {
			if ($(this).hasClass("active")) {
				found = index;
			}
		});

		if (found === undefined) {
			found = 0;
		}

		var next = (found + 1) % images.length;

		images.eq(next).css("opacity", 0);
		images.eq(next).addClass("over");
//		images.eq(next).addClass("active");
//		images.eq(found).removeClass("active");
//		images.eq(next).removeClass("over");

		images.eq(next).animate(
			{ opacity: 1 },
			750,
			function () {
				images.eq(next).addClass("active");
				images.eq(found).css("opacity", 0);
				images.eq(found).removeClass("active");
				images.eq(next).removeClass("over");
			}
		);

	}, duration);

}


// DOM Ready
$(function() {

	$('a').each(function (index) {
		if (this.getAttribute("href") && this.getAttribute("rel") === "external") {
			this.target = "_blank";
		}
	});

	$("#menu_control").click(function() {
		var nav = $('div.menu');
		nav.toggleClass('toggled_on');
		$(this).toggleClass('selected');
	});

	var slideshowObj = $("#home_slideshow");

	if (slideshowObj.length) {
		new Slideshow(slideshowObj);
	}

});
